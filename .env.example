# Copy this file to .env and fill in your local settings.
# The .env file is ignored by Git and must not be committed.

# Required for media encryption and, unless APP_PASSWORD is set, sign-in.
# Keep the same value as the legacy app if you need to read its media.
FERNET_PASSWORD=

# Optional separate sign-in password. If omitted, FERNET_PASSWORD is used.
# APP_PASSWORD=

# Optional for local development; set a unique random value before exposing
# the app outside your computer.
# SESSION_SECRET=

# Optional for local-only development. Set this to connect to the persistent vault.
MONGO_URI=

# Ports used by the one-command launcher.
API_PORT=8080
WEB_PORT=5173

# Optional storage and watcher locations.
MEDIA_DIR=./media
WATCH_DIR=./watch_inbox
DATA_DIR=./.data
# WATCHER_ENABLED=false

# Replit-only private object storage path; normally leave unset on your computer.
# PRIVATE_OBJECT_DIR=
