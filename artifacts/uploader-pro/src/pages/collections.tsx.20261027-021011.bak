import { useState } from 'react';
import type { FormEvent } from 'react';
import { Link } from 'wouter';
import { useQueryClient } from '@tanstack/react-query';
import { getListCollectionsQueryKey, useCreateCollection, useListCollections } from '@workspace/api-client-react';
import { ArrowUpRight, FolderHeart, Plus } from 'lucide-react';
import { PageHeading } from '@/components/uploader-shell';

export default function CollectionsPage() {
  const collections = useListCollections();
  const createCollection = useCreateCollection();
  const queryClient = useQueryClient();
  const [name, setName] = useState('');
  const create = (event: FormEvent) => { event.preventDefault(); if (!name.trim()) return; createCollection.mutate({ data: { name: name.trim() } }, { onSuccess: () => { setName(''); queryClient.invalidateQueries({ queryKey: getListCollectionsQueryKey() }); } }); };
  return <div className="mx-auto max-w-[1180px]"><PageHeading eyebrow="Library" title="Collections with a pulse." description="Give the archive a little shape. Collections are lightweight ways to return to a feeling, a place, or a season." action={<form onSubmit={create} className="flex gap-2"><input value={name} onChange={(e) => setName(e.target.value)} placeholder="New collection name" className="h-10 w-44 rounded-xl border border-input bg-card px-3 text-xs outline-none focus:border-primary sm:w-52" aria-label="New collection name" data-testid="input-collection-name" /><button disabled={createCollection.isPending} className="grid h-10 w-10 place-items-center rounded-xl bg-primary text-primary-foreground hover:-translate-y-0.5 disabled:opacity-60" type="submit" aria-label="Create collection" data-testid="button-create-collection"><Plus size={17} /></button></form>} />
     {collections.isLoading ? <CollectionSkeleton /> : collections.isError ? <div className="rounded-2xl border border-destructive/25 bg-destructive/5 px-6 py-16 text-center"><p className="font-serif font-bold">Collections are out of reach.</p><button onClick={() => collections.refetch()} className="mt-4 rounded-lg border border-border bg-card px-3 py-2 text-xs font-bold" data-testid="button-retry-collections">Try again</button></div> : collections.data?.length ? <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{collections.data.map((collection, index) => <Link key={collection.id} href={`/collections/${collection.id}`} className="vault-in group relative overflow-hidden rounded-2xl border border-border bg-card text-left shadow-sm transition-transform hover:-translate-y-1 hover:border-primary/40" style={{ animationDelay: `${index * 50}ms` }} data-testid={`card-collection-${collection.id}`}><div className="relative aspect-[1.7] overflow-hidden bg-secondary">{collection.coverThumbUrl ? <img src={collection.coverThumbUrl} alt="" className="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" /> : <div className="vault-grid grid h-full place-items-center"><FolderHeart size={34} className="text-primary/60" /></div>}<div className="absolute inset-0 bg-gradient-to-t from-background/75 to-transparent" /><span className="absolute bottom-3 left-3 rounded-md bg-background/55 px-2 py-1 font-mono text-[10px] text-foreground backdrop-blur">{collection.itemCount} items</span><ArrowUpRight size={17} className="absolute bottom-3 right-3 text-foreground opacity-0 transition-opacity group-hover:opacity-100" /></div><div className="p-4"><h2 className="font-serif text-base font-bold">{collection.name}</h2><p className="mt-1 text-xs text-muted-foreground">Open collection</p></div></Link>)}</div> : <div className="vault-grid rounded-2xl border border-dashed border-border px-6 py-20 text-center"><div className="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-primary/10 text-primary"><FolderHeart size={24} /></div><h3 className="mt-5 font-serif text-lg font-bold">Start with a feeling</h3><p className="mx-auto mt-2 max-w-sm text-sm text-muted-foreground">Create a collection above to give your favourite places and people a home.</p></div>}
  </div>;
}</div>;
}

function CollectionSkeleton() { return <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{[1, 2, 3].map((item) => <div key={item} className="overflow-hidden rounded-2xl border border-border bg-card"><div className="shimmer aspect-[1.7]" /><div className="space-y-2 p-4"><div className="shimmer h-4 w-2/3 rounded" /><div className="shimmer h-3 w-1/3 rounded" /></div></div>)}</div>; }